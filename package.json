{
  "name": "a-beautiful-point",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "preview": "astro preview",
    "data:setup": "python3 -m venv .venv-data && .venv-data/bin/python -m pip install --upgrade pip && .venv-data/bin/python -m pip install -r requirements-data.txt",
    "data:doctor": ".venv-data/bin/python scripts/data/homelessness_pipeline.py doctor",
    "data:discover": ".venv-data/bin/python scripts/data/homelessness_pipeline.py discover"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.6",
    "astro": "^6.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "typescript": "^6.0.3"
  }
}
