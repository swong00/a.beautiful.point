---
import BaseLayout from "@components/layout/BaseLayout.astro";
import { getCollection, render } from "astro:content";

const entries = (await getCollection("manifesto")).sort((a, b) => a.data.order - b.data.order);
const entry = entries[0];

if (!entry) {
  throw new Error("Expected a manifesto entry in src/content/manifesto.");
}

const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <article class="section">
    <div class="prose">
      <p class="meta-line">
        <span>{entry.data.section}</span>
        <span>{entry.data.date.toISOString().slice(0, 10)}</span>
        <span>{entry.data.status}</span>
      </p>
      <h1>{entry.data.title}</h1>
      <p class="lede">{entry.data.description}</p>
      <Content />
    </div>
  </article>
</BaseLayout>
