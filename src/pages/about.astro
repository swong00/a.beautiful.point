---
import BaseLayout from "@components/layout/BaseLayout.astro";
---

<BaseLayout title="About" description="Mission, principles, and work-with-me bridge for A Beautiful Point.">
  <section class="section">
    <div class="narrow">
      <p class="eyebrow">About the lab</p>
      <h1>About</h1>
      <p class="lede">
        A Beautiful Point is the public lab of Siew Wong, a software architect
        and SRE leader exploring the intersection of systems engineering, data
        intelligence, AI, and visual explanation.
      </p>
    </div>
  </section>
  <section class="section section--white">
    <div class="wrap grid">
      <article class="artifact-card">
        <div class="meta"><span>mission</span></div>
        <h3>Make complexity legible.</h3>
        <p>Show the system, the hidden structure, the leverage point, and the action.</p>
      </article>
      <article class="artifact-card">
        <div class="meta"><span>principle</span></div>
        <h3>Static first.</h3>
        <p>Keep artifacts inspectable in the repo before adding platform machinery.</p>
      </article>
      <article class="artifact-card">
        <div class="meta"><span>bridge</span></div>
        <h3>Build with operators.</h3>
        <p>Focus on reliability, healthcare, manufacturing, infrastructure, finance, and AI systems.</p>
      </article>
    </div>
  </section>
</BaseLayout>
