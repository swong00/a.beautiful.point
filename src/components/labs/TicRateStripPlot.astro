---
// Build-time strip plot: one dot = one retained published fact, faceted by
// billing class and negotiated type so different kinds of statements are never
// silently mixed. No client JavaScript; jitter is deterministic per record.
// Facet and axis labels are HTML text (not scaled SVG text) so they stay
// readable at mobile widths; the dot bands are decorative SVG with the same
// information carried by the labels and the table.
import {
  formatAmount,
  loadCodeFacts,
  type TicFact,
} from "@lib/tic-pricing-slice";

interface Props {
  code: string;
}

const { code } = Astro.props;
const facts = loadCodeFacts(code);

const facetOrder = [
  ["professional", "fee schedule"],
  ["professional", "negotiated"],
  ["institutional", "fee schedule"],
  ["institutional", "negotiated"],
] as const;

const facets = facetOrder
  .map(([billingClass, negotiatedType]) => ({
    billingClass,
    negotiatedType,
    facts: facts.filter(
      (fact) =>
        fact.billing_class === billingClass &&
        fact.negotiated_type === negotiatedType,
    ),
  }))
  .filter((facet) => facet.facts.length > 0);

const maxAmount = Math.max(...facts.map((fact) => fact.amount));

// Nice axis: pick a step of 1/2/2.5/5 × 10^n giving four to six ticks from $0.
function niceStep(rawStep: number): number {
  const magnitude = 10 ** Math.floor(Math.log10(rawStep));
  for (const multiple of [1, 2, 2.5, 5, 10]) {
    if (magnitude * multiple >= rawStep) return magnitude * multiple;
  }
  return magnitude * 10;
}
const step = niceStep(maxAmount / 5);
const axisMax = Math.ceil(maxAmount / step) * step;
const ticks = Array.from({ length: Math.round(axisMax / step) + 1 }, (_, i) => i * step);

const plotLeft = 12;
const plotRight = 688;
const bandHeight = 46;
const plotWidth = plotRight - plotLeft;

const xFor = (amount: number) => plotLeft + (amount / axisMax) * plotWidth;
const percentFor = (amount: number) => ((xFor(amount) / 700) * 100).toFixed(3);

// Deterministic per-record jitter inside the band (no randomness, no meaning).
function jitterFor(fact: TicFact): number {
  let hash = 0;
  for (const char of fact.fact_key) {
    hash = (hash * 31 + char.charCodeAt(0)) % 1_000_003;
  }
  return hash / 1_000_003;
}
---

<figure class="strip-plot">
  <figcaption>
    Every retained published amount for CPT {code} — one dot is one retained
    source fact (never one provider), faceted by billing class and negotiated
    type. Dot height within a band is random jitter with no meaning, and the
    $0–${formatAmount(axisMax).replace(".00", "")} scale below is the axis
    range, not observed amounts.
  </figcaption>
  {
    facets.map((facet) => (
      <div class="facet">
        <p class="facet-label">
          {facet.billingClass} · {facet.negotiatedType} —{" "}
          {facet.facts.length.toLocaleString("en-US")} retained facts
        </p>
        <svg viewBox={`0 0 700 ${bandHeight}`} aria-hidden="true">
          <line
            class="band-line"
            x1={plotLeft}
            x2={plotRight}
            y1={bandHeight - 1}
            y2={bandHeight - 1}
          />
          {facet.facts.map((fact) => (
            <circle
              class="dot"
              cx={xFor(fact.amount).toFixed(1)}
              cy={(5 + jitterFor(fact) * (bandHeight - 12)).toFixed(1)}
              r="2.4"
            />
          ))}
        </svg>
      </div>
    ))
  }
  <div class="axis" aria-hidden="true">
    {
      ticks.map((tick) => (
        <span
          class:list={[
            "tick",
            tick === 0 ? "first" : tick === axisMax ? "last" : undefined,
          ]}
          style={`left: ${percentFor(tick)}%`}
        >
          ${formatAmount(tick).replace(".00", "")}
        </span>
      ))
    }
  </div>
</figure>

<style>
  .strip-plot {
    margin: 1.5rem 0;
    padding: 1.2rem;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--surface);
  }

  figcaption {
    margin-bottom: 1rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .facet {
    margin-bottom: 0.9rem;
  }

  .facet-label {
    margin: 0 0 0.25rem;
    color: var(--teal-deep);
    font-family: var(--mono);
    font-size: 0.74rem;
    font-weight: 500;
    text-transform: uppercase;
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .band-line {
    stroke: var(--line);
    stroke-width: 1;
  }

  .dot {
    fill: var(--teal);
    fill-opacity: 0.3;
  }

  .axis {
    position: relative;
    height: 1.4rem;
    border-top: 1px solid var(--line);
  }

  .tick {
    position: absolute;
    top: 0.2rem;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.72rem;
    transform: translateX(-50%);
    white-space: nowrap;
  }

  .tick.first {
    transform: none;
  }

  .tick.last {
    transform: translateX(-100%);
  }
</style>
