---
interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
}

const {
  title = "A Beautiful Point",
  description = "Visual explanations for complex systems.",
  currentPath = Astro.url.pathname,
} = Astro.props;

const pageTitle = title === "A Beautiful Point" ? title : `${title} | A Beautiful Point`;
const navItems = [
  { href: "/", label: "Home" },
  { href: "/manifesto", label: "Manifesto" },
  { href: "/essays", label: "Essays" },
  { href: "/visuals", label: "Visuals" },
  { href: "/labs", label: "Labs" },
  { href: "/notes", label: "Notes" },
  { href: "/about", label: "About" },
];

const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="A Beautiful Point home">
        <span class="brand-mark" aria-hidden="true"></span>
        <span>A Beautiful Point</span>
      </a>
      <nav aria-label="Primary navigation">
        {
          navItems.map((item) => (
            <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>Systems, data, visuals, software, action.</p>
      <a href="/about">Work with the lab</a>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --ink: #201f1d;
    --muted: #716e66;
    --paper: #faf9f5;
    --surface: #f6f2ea;
    --line: #d9d2c6;
    --teal: #1f6f7a;
    --teal-deep: #174f57;
    --amber: #c07a1a;
    --rose: #9d4e5d;
    --blue: #2d5f9a;
    --green: #557a32;
    --shadow: none;
    --serif:
      "Iowan Old Style", "Palatino Linotype", Palatino, "Book Antiqua", Georgia,
      serif;
    --sans:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
    --mono:
      "Courier Prime", "Courier New", ui-monospace, SFMono-Regular, Menlo, Consolas,
      monospace;
    font-family: var(--serif);
    font-size: 16px;
    line-height: 1.5;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    min-width: 320px;
    background: var(--paper);
    color: var(--ink);
  }

  body::before {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    content: "";
    background:
      linear-gradient(rgba(32, 31, 29, 0.026) 1px, transparent 1px),
      linear-gradient(90deg, rgba(32, 31, 29, 0.026) 1px, transparent 1px);
    background-size: 42px 42px;
    mask-image: linear-gradient(to bottom, black, transparent 58%);
  }

  a {
    color: inherit;
  }

  p,
  li {
    color: var(--muted);
  }

  img,
  svg {
    max-width: 100%;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 0.9rem clamp(1rem, 3vw, 3rem);
    border-bottom: 1px solid rgba(32, 31, 29, 0.12);
    background: rgba(250, 249, 245, 0.92);
    backdrop-filter: blur(14px);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    min-width: max-content;
    color: var(--ink);
    font-family: var(--serif);
    font-weight: 400;
    text-decoration: none;
  }

  .brand-mark {
    width: 0.8rem;
    height: 0.8rem;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--amber);
    box-shadow: 0 0 0 4px var(--paper);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.35rem 0.75rem;
  }

  nav a {
    border-bottom: 2px solid transparent;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.78rem;
    font-weight: 500;
    text-decoration: none;
  }

  nav a:hover,
  nav a[aria-current="page"] {
    border-color: var(--teal);
    color: var(--ink);
  }

  main {
    min-height: 70vh;
  }

  .section {
    padding: clamp(3rem, 7vw, 6rem) clamp(1rem, 3vw, 3rem);
  }

  .section--white {
    border-block: 1px solid rgba(32, 31, 29, 0.1);
    background: var(--surface);
  }

  .wrap {
    width: min(1120px, 100%);
    margin: 0 auto;
  }

  .narrow {
    width: min(760px, 100%);
    margin: 0 auto;
  }

  .eyebrow {
    margin: 0 0 0.7rem;
    color: var(--teal-deep);
    font-family: var(--mono);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3 {
    margin: 0;
    color: var(--ink);
    font-family: var(--serif);
    font-weight: 400;
    line-height: 1.04;
    letter-spacing: 0;
  }

  h1 {
    max-width: 860px;
    font-size: 6.25rem;
  }

  h2 {
    font-size: 3.4rem;
  }

  h3 {
    font-size: 1.45rem;
  }

  .lede {
    max-width: 760px;
    color: #3f3b36;
    font-size: 1.35rem;
  }

  .button-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  .text-link,
  .button-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-family: var(--mono);
    font-size: 0.86rem;
    font-weight: 500;
    text-decoration: none;
  }

  .button-link {
    padding: 0 1rem;
    border: 1px solid var(--ink);
    border-radius: 4px;
    background: var(--ink);
    color: var(--surface);
  }

  .button-link:hover {
    background: var(--teal-deep);
  }

  .text-link {
    color: var(--teal-deep);
  }

  .text-link:hover {
    color: var(--rose);
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(320px, 1.1fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 2rem;
  }

  .artifact-card {
    display: flex;
    flex-direction: column;
    min-height: 18rem;
    padding: 1.1rem;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--surface);
    box-shadow: var(--shadow);
    text-decoration: none;
  }

  .artifact-card:hover {
    border-color: var(--teal);
    transform: translateY(-2px);
  }

  .artifact-card p {
    margin: 0.75rem 0;
  }

  .artifact-card .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
    color: var(--teal-deep);
    font-family: var(--mono);
    font-size: 0.78rem;
    font-weight: 500;
    text-transform: uppercase;
  }

  .artifact-card .point {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    color: var(--ink);
    font-weight: 680;
  }

  .prose {
    width: min(760px, 100%);
    margin: 0 auto;
    padding-block: clamp(3rem, 7vw, 6rem);
  }

  .prose h1 {
    margin-bottom: 1.2rem;
    font-size: 4.25rem;
  }

  .prose h2 {
    margin-top: 3rem;
    font-size: 2.35rem;
  }

  .prose p,
  .prose li {
    font-size: 1.08rem;
  }

  .prose blockquote {
    margin: 2rem 0;
    padding: 0 0 0 1.2rem;
    border-left: 4px solid var(--amber);
    color: var(--ink);
    font-size: 1.35rem;
    font-weight: 680;
  }

  .meta-line {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0 0 1rem;
    color: var(--teal-deep);
    font-family: var(--mono);
    font-size: 0.82rem;
    font-weight: 500;
  }

  .site-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 2rem clamp(1rem, 3vw, 3rem);
    border-top: 1px solid rgba(32, 31, 29, 0.12);
  }

  .site-footer p {
    margin: 0;
  }

  .site-footer a {
    color: var(--teal-deep);
    font-weight: 760;
  }

  @media (max-width: 840px) {
    .site-header {
      align-items: flex-start;
      flex-direction: column;
    }

    nav {
      justify-content: flex-start;
    }

    .split,
    .grid {
      grid-template-columns: 1fr;
    }

    h1 {
      font-size: 4.2rem;
    }

    h2 {
      font-size: 2.55rem;
    }

    .lede {
      font-size: 1.2rem;
    }

    .prose h1 {
      font-size: 3.1rem;
    }

    .prose h2 {
      font-size: 2rem;
    }
  }

  @media (max-width: 520px) {
    h1 {
      font-size: 3.25rem;
    }

    h2 {
      font-size: 2.1rem;
    }

    h3 {
      font-size: 1.3rem;
    }
  }
</style>
